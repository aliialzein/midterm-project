FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1

COPY requirements-metadata.txt ./
RUN pip install --no-cache-dir -r requirements-metadata.txt

COPY metadata_service ./metadata_service

EXPOSE 8000
CMD ["uvicorn", "metadata_service.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
